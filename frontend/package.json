    "motion": "^12.23.0",
    "next": "^16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
