# ID del proyecto de Sanity (sanity.io/manage). Es público: el dataset es de solo lectura.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# URL pública del sitio, sin / final. En producción: https://tenisdemesani.com
# Se usa al compilar (canónicas, sitemap, robots, Open Graph): si no es HTTPS,
# robots.txt bloquea la indexación a propósito.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: token del método "Etiqueta HTML" de Google Search Console.
GOOGLE_SITE_VERIFICATION=
# El número de WhatsApp no es una variable: está en src/lib/contact.ts.
